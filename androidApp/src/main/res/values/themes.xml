<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: system splash (Android 12+ and back-ported by core-splashscreen)
         in the brand background with the app glyph, then the app theme. -->
    <style name="Theme.MovieClub.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#222831</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MovieClub</item>
    </style>

    <style name="Theme.MovieClub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#222831</item>
    </style>
</resources>
